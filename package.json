{
  "name": "artemis-ii",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/ingest.ts --build --out media-out",
    "build": "astro build",
    "preview": "astro preview",
    "ingest": "node scripts/ingest.ts",
    "check": "astro check && npm run typecheck",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit -p tsconfig.json",
    "test:scripts": "node --test scripts/*.test.ts",
    "test:gitleaks": "node --test scripts/security/gitleaks-allowlist.test.ts",
    "test": "npm run test:scripts && npm run build && playwright test"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "parse5": "8.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript7": "npm:typescript@^7.0.2",
    "yaml": "^2.9.1"
  }
}

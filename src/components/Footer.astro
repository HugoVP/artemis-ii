---
import { sectionPath, type Lang } from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const f = ui[lang].footer;
---

<footer class="bg-surface">
  <div class="px-4 py-5 grid gap-3">
    <p class="m-0 text-label font-semibold"><a class="text-text no-underline" href={f.creditLink} rel="noopener noreferrer">{f.credit}</a></p>
    <p class="m-0 text-caption text-muted">{f.independence}</p>
    <p class="m-0 text-label">{f.ai} <a class="text-text underline" href={`${sectionPath(lang, 'about')}#ai`}>{f.aiLink}</a></p>
  </div>
</footer>

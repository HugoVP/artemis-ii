---
import { alternatePath, sectionPath, sections, type Lang } from '../i18n/routes';
import Preferences from './Preferences';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const t = ui[lang];
const gallery = path.startsWith(sectionPath(lang, 'gallery'));
const current = (href: string) => (href === `/${lang}/` ? path === href : path.startsWith(href));
---

<header class="border-b border-border bg-background">
  <div class="max-w-content mx-auto px-4 py-3 flex items-center justify-between gap-3">
    <a href={`/${lang}/`} class="font-display text-h3 text-text no-underline">{t.siteName}</a>

    <nav aria-label={t.navLabel} class="hidden md:block">
      <ul class="flex gap-4 list-none m-0 p-0">
        {
          sections.map((s) => {
            const href = sectionPath(lang, s);
            return (
              <li>
                <a href={href} aria-current={current(href) ? 'page' : undefined} class="text-label">
                  {t.nav[s]}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Settings (desktop) / Menu (mobile): a native popover with a React preferences island. -->
    <button
      type="button"
      popovertarget="prefs"
      class="rounded-sm border border-border bg-surface text-text px-3 py-2 text-label cursor-pointer"
    >
      <span class="md:hidden">{t.menu}</span>
      <span class="hidden md:inline">{t.settings}</span>
    </button>
  </div>

  <div id="prefs" popover class="m-0 right-3 top-12 rounded-md border border-border bg-surface text-text p-4 preferences-popover">
    <nav aria-label={t.navLabel} class="md:hidden mb-4">
      <ul class="list-none m-0 p-0 grid gap-2">
        {
          sections.map((s) => (
            <li>
              <a href={sectionPath(lang, s)} class="text-label">
                {t.nav[s]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <Preferences client:load lang={lang} alternate={alternatePath(path)} labels={t.preferences} gallery={gallery} />
  </div>
</header>

<style>
  nav a[aria-current='page'] {
    text-decoration: none;
    font-weight: 600;
  }
</style>

---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import { ui } from '../i18n/ui';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Open Graph image (GAL-06): a same-origin `/media` URL with its size. */
  image?: { url: string; alt: string; width: number; height: number };
}
const { lang, title, description, image } = Astro.props;
const path = Astro.url.pathname;
const fullTitle = title === ui[lang].siteName ? title : `${title} · ${ui[lang].siteName}`;
---

<!doctype html>
<html lang={lang} data-theme="dark" data-density="comfortable">
  <head>
    <meta charset="utf-8" />
    <!-- External classic script deliberately blocks parsing to restore preferences before paint. -->
    <script is:inline src="/preferences.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {
      image && (
        <>
          <meta property="og:title" content={fullTitle} />
          <meta property="og:image" content={new URL(image.url, Astro.url).href} />
          <meta property="og:image:width" content={String(image.width)} />
          <meta property="og:image:height" content={String(image.height)} />
          <meta property="og:image:alt" content={image.alt} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={new URL(image.url, Astro.url).href} />
        </>
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <a class="skip-link" href="#main">{ui[lang].skip}</a>
    <TopBar lang={lang} path={path} />
    <main id="main" class="flex-1 w-full max-w-content mx-auto px-4 py-5">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
